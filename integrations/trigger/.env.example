# Customer-owned services only. Fill values in the server's secret store, never chat/Git.
# Keep CLI, SDK and self-hosted Trigger release aligned at 4.8.3 for this scaffold.
TRIGGER_API_URL=http://localhost:8030
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
# Explicit full API prefix, matching the chosen Skyvern instance's OpenAPI docs.
SKYVERN_API_BASE_URL=http://skyvern:8000/v1
SKYVERN_API_KEY=
SKYVERN_ALLOWED_WORKFLOW_IDS=
# Separate application ledger database, not Trigger's internal database.
ERNESTA_LEDGER_DATABASE_URL=
# 64 hexadecimal chars from secret manager. Owner approval process uses same key.
WORKFLOW_APPROVAL_KEY=
# Set on self-hosted Trigger webapp too, not only on task workers:
TRIGGER_TELEMETRY_DISABLED=1
