#!/usr/bin/env bash
set -euo pipefail
display="${1:?display number required}"
shift
case "$display" in 99|100|101|102) ;; *) echo '{"ok":false,"error":{"code":"INVALID_DISPLAY"}}'; exit 2;; esac
. /tmp/agent-desktop-session.env
export DISPLAY=":$display"
export AGENT_DESKTOP_HOME=/root/.agent-desktop
exec agent-desktop "$@"
