/** Copy into a version-pinned self-hosted Trigger project after installing @trigger.dev/sdk@4.8.3.
 * A successful observation task is NOT a successful business workflow.
 * Read-only observer: retries never re-submit a browser task.
 */
import { task } from '@trigger.dev/sdk';
import { skyvernClient } from '../skyvern.mjs';
export const observeBrowserRun = task({
  id: 'ernesta-skyvern-observe',
  maxDuration: 30,
  retry: { maxAttempts: 3, minTimeoutInMs: 1000, maxTimeoutInMs: 5000, factor: 2 },
  run: async (payload: { providerRunId: string }) => {
    const client = skyvernClient({
      baseUrl: process.env.BOPS_SKYVERN_BASE_URL,
      apiKey: process.env.BOPS_SKYVERN_API_KEY,
    });
    return await client.observe(payload.providerRunId);
  },
});
