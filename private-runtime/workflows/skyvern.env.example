# Configure on the customer server; no actual credentials are included.
# Trigger's approved-browser-workflow task -> private Skyvern API (service root,
# each client appends its own /v1 path). These are readiness inputs for the
# queue_workflow tool, not a second dispatch path.
# Canonical names. The legacy BOPS_SKYVERN_BASE_URL / BOPS_SKYVERN_API_KEY
# spellings still resolve, but new deployments should use these.
SKYVERN_API_BASE_URL=http://127.0.0.1:8000
SKYVERN_API_KEY=
SKYVERN_ALLOWED_WORKFLOW_IDS=

# The following belong in SKYVERN's own environment, not merely Bops'.
ENABLE_OPENAI=false
ENABLE_XAI=false
ENABLE_OLLAMA=false
ENABLE_OPENAI_COMPATIBLE=true
LLM_KEY=OPENAI_COMPATIBLE
SECONDARY_LLM_KEY=OPENAI_COMPATIBLE
OPENAI_COMPATIBLE_MODEL_NAME=
OPENAI_COMPATIBLE_API_BASE=
OPENAI_COMPATIBLE_API_KEY=
# The API format does not require OpenAI as the provider. Choose a non-OpenAI,
# non-xAI vision-capable hosted model; validate its output before activation.
SKYVERN_TELEMETRY=false
ENABLE_URL_VALIDATION=true
ENABLE_LOG_ARTIFACTS=false
ENABLE_WORKFLOW_SCHEDULES=false
MAX_STEPS_PER_RUN=20
# Configure extraction, copilot and script-generation models explicitly too.
# Do not enable customer tasks until outbound traffic and all model paths pass.
