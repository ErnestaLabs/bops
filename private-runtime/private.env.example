# Copy to .env.private (ignored by Git), chmod 600, then edit on the customer server.
# Do not paste actual credentials into a chat or commit them.
BOPS_INFERENCE_BASE_URL=
BOPS_INFERENCE_MODEL=
BOPS_INFERENCE_API_KEY=
# Use an absolute, persistent directory outside the checkout for customer deployments.
# BOPS_PRIVATE_DATA_DIR=/srv/ernesta-private/data
PORT=3210
# Owner permission for model-driven mouse/keyboard actions:
BOPS_PRIVATE_COMPUTER_ACTIONS=1
# Offline by default. Set an existing owner-approved Docker network for web tasks.
BOPS_WORKER_NETWORK=none
BOPS_WORKER_CPUS=2
BOPS_WORKER_MEMORY_GB=4
# Keep the generated install-id, ui-token and vault-key stable across updates.
